BOT_TOKEN=
ALLOWED_USER_IDS=
OWNER_USER_IDS=
# Owner-only OCR bridge. Use the ChatGPT bot URL ending in /internal/ocr/image.
CHATGPT_OCR_URL=
CHATGPT_OCR_TOKEN=

HOST=0.0.0.0
PORT=8080
# For Render Persistent Disk, set to /var/data/bot.sqlite3 and mount the disk at /var/data.
DATABASE_PATH=data/bot.sqlite3

# Optional public HTTPS URL for the Mini App in local/staging environments.
# On Render, RENDER_EXTERNAL_URL is used automatically.
MINI_APP_URL=

RENDER_FREE_MODE=1
ENABLE_FILE_LOG=0

BACKUP_INTERVAL_HOURS=24

# Active database backend: sqlite or turso. Keep sqlite until migration is complete.
DATABASE_BACKEND=sqlite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional Google Drive backup bridge (Google Apps Script web app)
GDRIVE_WEBAPP_URL=
GDRIVE_SHARED_SECRET=
